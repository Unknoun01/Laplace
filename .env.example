# --- Backend ---
LAPLACE_CLICKHOUSE_HOST=localhost
LAPLACE_CLICKHOUSE_PORT=8123
LAPLACE_CLICKHOUSE_USER=laplace
LAPLACE_CLICKHOUSE_PASSWORD=laplace
LAPLACE_CLICKHOUSE_DATABASE=laplace

# 5433 y no 5432: el contenedor se publica en 5433 para no chocar con un
# Postgres instalado en la maquina.
LAPLACE_POSTGRES_DSN=postgresql://laplace:laplace@localhost:5433/laplace

# Comma-separated origins allowed to call the read API.
LAPLACE_CORS_ORIGINS=http://localhost:3000

# --- SDK (in the user's own project) ---
# Where the SDK ships spans. Must be the OTLP/HTTP base endpoint.
LAPLACE_ENDPOINT=http://localhost:4318
LAPLACE_API_KEY=
LAPLACE_PROJECT=default

# --- Web ---
# Read API base URL used by the Next.js server components.
LAPLACE_API_URL=http://localhost:8000

# --- Alertas a Slack (Fase 2, punto 3) ---
# Apagadas por defecto. Funcionan igual en la nube y en `laplace ui`.
LAPLACE_ALERTS_ENABLED=false
# Webhook entrante de Slack. Es un secreto: va aqui, nunca en alerts.json.
LAPLACE_ALERTS_SLACK_WEBHOOK=
# Raiz publica de la interfaz, para el enlace a la ficha del problema.
LAPLACE_ALERTS_BASE_URL=http://localhost:3000
# Umbral por defecto, en dolares YA GASTADOS en la ventana (no proyectados).
LAPLACE_ALERTS_MIN_USD=1.0
# Horas de silencio por hallazgo tras avisar de el. Es el freno contra la repeticion.
LAPLACE_ALERTS_QUIET_HOURS=24
LAPLACE_ALERTS_WINDOW_DAYS=7
LAPLACE_ALERTS_INTERVAL_SECONDS=300
# Ajustes por proyecto (umbral, silenciado, webhook propio). Ver alerts.py.
LAPLACE_ALERTS_CONFIG_PATH=
